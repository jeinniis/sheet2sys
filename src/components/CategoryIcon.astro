---
interface Props {
  icon: string; // inner SVG markup from src/lib/categories.js
  size?: number;
  class?: string;
}

const { icon, size = 20, class: className } = Astro.props;
---

<svg
  class={className}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  set:html={icon}
/>
