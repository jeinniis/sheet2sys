---
// The icon+input(+kbd) search control, shared between the homepage hero
// and /search/ — previously copy-pasted with inline `style=` overrides on
// each page for size/width/kbd differences. Those are props now.
interface Props {
  id: string;
  name?: string;
  placeholder: string;
  size?: 'default' | 'lg';
  showKbd?: boolean;
  fill?: boolean;
  autofocus?: boolean;
}

const { id, name = 'q', placeholder, size = 'default', showKbd = false, fill = false, autofocus = false } =
  Astro.props;
---

<div
  class:list={[
    'search-hero',
    { 'search-hero-lg': size === 'lg', 'search-hero-fill': fill, 'search-hero-no-kbd': !showKbd },
  ]}
>
  <svg
    class="search-icon"
    width="18"
    height="18"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="7" />
    <line x1="21" y1="21" x2="16.65" y2="16.65" />
  </svg>
  <input class="input" type="search" name={name} id={id} placeholder={placeholder} autocomplete="off" autofocus={autofocus} />
  {showKbd && <kbd class="kbd">⌘K</kbd>}
</div>
