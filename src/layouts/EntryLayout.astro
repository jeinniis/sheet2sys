---
import BaseLayout from './BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getCategory } from '../lib/categories.js';

interface Props {
  data: {
    title: string;
    type: 'note' | 'case';
    category: string;
    tags: string[];
    updated: Date;
  };
  backlinks: { slug: string; title: string; url: string }[];
}

const { data, backlinks } = Astro.props;
const category = getCategory(data.category);
const updatedLabel = new Intl.DateTimeFormat('th-TH', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
}).format(data.updated);
---

<BaseLayout title={data.title}>
  <Breadcrumbs
    items={[
      { label: 'Home', href: '/' },
      { label: category?.label ?? data.category, href: `/${data.category}/` },
      { label: data.title },
    ]}
  />

  <article>
    <p>
      <a class="badge" href={`/${data.category}/`}>{category?.icon} {category?.label}</a>
      {data.type === 'case' && <span class="badge badge-accent">Case</span>}
    </p>
    <h1>{data.title}</h1>
    <p class="meta">อัปเดตล่าสุด {updatedLabel}</p>

    <div class="prose">
      <slot />
    </div>

    {data.tags.length > 0 && (
      <div class="tag-row">
        {data.tags.map((tag) => <a class="tag-link" href={`/tags/${tag}/`}>{tag}</a>)}
      </div>
    )}
  </article>

  {backlinks.length > 0 && (
    <section class="section section-divided">
      <div class="section-heading">
        <h2>ของที่ลิงก์มาที่นี่</h2>
      </div>
      <ul class="list">
        {backlinks.map((b) => (
          <li class="list-row">
            <a href={b.url}>
              <div class="list-row-title">{b.title}</div>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
