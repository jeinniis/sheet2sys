---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ArticleItem from '../../components/ArticleItem.astro';
import { getCategory } from '../../lib/categories.js';
import { formatUpdated, entryUrl } from '../../lib/format.js';

const entries = (await getCollection('library', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.updated.valueOf() - a.data.updated.valueOf()
);
---

<BaseLayout title="Notes" description="ทุกโน้ตในคลัง DotStack เรียงตามอัปเดตล่าสุด">
  <PageHeader
    title="Notes"
    description="ทุกชิ้นในคลัง เรียงตามอัปเดตล่าสุด"
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'Notes' }]}
  />

  {entries.length === 0 ? (
    <p class="empty-state">ยังไม่มีของในคลัง</p>
  ) : (
    <ul class="list">
      {entries.map((entry) => {
        const category = getCategory(entry.data.category);
        return (
          <ArticleItem
            href={entryUrl(entry)}
            title={entry.data.title}
            eyebrow={`${category?.label} · ${formatUpdated(entry.data.updated)}`}
            description={entry.data.description}
          />
        );
      })}
    </ul>
  )}
</BaseLayout>
