---
import { getCollection, render } from 'astro:content';
import EntryLayout from '../../layouts/EntryLayout.astro';
import { getBacklinks, validateGraph } from '../../lib/content-graph.js';

export async function getStaticPaths() {
  const entries = await getCollection('library', ({ data }) => !data.draft);
  // Validate the whole link graph (duplicate slugs, broken/Draft-target
  // wikilinks) here, in plain path-collection code, before any page
  // renders — see the comment on validateGraph() for why it can't live
  // inside the markdown-render path instead.
  validateGraph();
  return entries.map((entry) => {
    const slug = entry.id.split('/').pop();
    return {
      params: { category: entry.data.category, slug },
      props: { entry, slug },
    };
  });
}

const { entry, slug } = Astro.props;
const { Content } = await render(entry);
const backlinks = getBacklinks(slug);
---

<EntryLayout data={entry.data} backlinks={backlinks}>
  <Content />
</EntryLayout>
