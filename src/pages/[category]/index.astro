---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import ArticleItem from '../../components/ArticleItem.astro';
import { CATEGORIES, getCategory } from '../../lib/categories.js';
import CategoryIcon from '../../components/CategoryIcon.astro';
import { formatUpdated, entryUrl } from '../../lib/format.js';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const { category: categorySlug } = Astro.params;
const category = getCategory(categorySlug);

const entries = (await getCollection('library', ({ data }) => !data.draft))
  .filter((e) => e.data.category === categorySlug)
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
---

<BaseLayout title={category?.label ?? categorySlug} description={category?.description}>
  <PageHeader
    title={category?.label ?? categorySlug}
    description={category?.description}
    meta={`${entries.length} notes`}
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: category?.label ?? categorySlug }]}
  >
    <CategoryIcon slot="icon" icon={category?.icon ?? ''} size={28} />
  </PageHeader>

  {entries.length === 0 ? (
    <p class="empty-state">ยังไม่มีของในหมวดนี้</p>
  ) : (
    <ul class="list">
      {entries.map((entry) => (
        <ArticleItem
          href={entryUrl(entry)}
          title={entry.data.title}
          badge={entry.data.type === 'case' ? 'Case' : undefined}
          metaText={`อัปเดต ${formatUpdated(entry.data.updated)}`}
        />
      ))}
    </ul>
  )}
</BaseLayout>
