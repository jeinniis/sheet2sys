---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { CATEGORIES, getCategory } from '../../lib/categories.js';

export async function getStaticPaths() {
  return CATEGORIES.map((c) => ({ params: { category: c.slug } }));
}

const { category: categorySlug } = Astro.params;
const category = getCategory(categorySlug);

const entries = (await getCollection('library', ({ data }) => !data.draft))
  .filter((e) => e.data.category === categorySlug)
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
---

<BaseLayout title={category?.label ?? categorySlug} description={category?.description}>
  <Breadcrumbs items={[{ label: 'Home', href: '/' }, { label: category?.label ?? categorySlug }]} />
  <h1><span aria-hidden="true">{category?.icon}</span> {category?.label}</h1>
  <p class="lede">{category?.description}</p>

  {entries.length === 0 ? (
    <p class="empty-state">ยังไม่มีของในหมวดนี้</p>
  ) : (
    <ul class="list" style="margin-top: 1.5rem;">
      {entries.map((entry) => {
        const slug = entry.id.split('/').pop();
        const updated = new Intl.DateTimeFormat('th-TH', { year: 'numeric', month: 'short', day: 'numeric' }).format(
          entry.data.updated
        );
        return (
          <li class="list-row">
            <a href={`/${categorySlug}/${slug}/`}>
              <div class="list-row-title">{entry.data.title}</div>
              <div class="list-row-meta">
                {entry.data.type === 'case' && <span class="badge badge-accent">Case</span>}
                <span>อัปเดต {updated}</span>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
  )}
</BaseLayout>
