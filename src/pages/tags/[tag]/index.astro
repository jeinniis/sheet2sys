---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import ArticleItem from '../../../components/ArticleItem.astro';
import { getCategory } from '../../../lib/categories.js';
import { groupByTag } from '../../../lib/tags.js';
import { formatUpdated, entryUrl } from '../../../lib/format.js';

export async function getStaticPaths() {
  const entries = await getCollection('library', ({ data }) => !data.draft);
  const byTag = groupByTag(entries);
  return [...byTag.keys()].map((tag) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const entries = (await getCollection('library', ({ data }) => !data.draft))
  .filter((e) => e.data.tags.includes(tag))
  .sort((a, b) => b.data.updated.valueOf() - a.data.updated.valueOf());
---

<BaseLayout title={`#${tag}`} description={`ของในคลังที่ติดแท็ก ${tag}`}>
  <PageHeader
    title={`#${tag}`}
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'แท็ก', href: '/tags/' }, { label: tag }]}
  />

  <ul class="list">
    {entries.map((entry) => {
      const category = getCategory(entry.data.category);
      return (
        <ArticleItem
          href={entryUrl(entry)}
          title={entry.data.title}
          eyebrow={`${category?.label} · ${formatUpdated(entry.data.updated)}`}
          description={entry.data.description}
        />
      );
    })}
  </ul>
</BaseLayout>
