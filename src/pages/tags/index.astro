---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { groupByTag } from '../../lib/tags.js';

const entries = await getCollection('library', ({ data }) => !data.draft);
const byTag = groupByTag(entries);
const tags = [...byTag.entries()].sort((a, b) => b[1].length - a[1].length);
---

<BaseLayout title="แท็กทั้งหมด" description="เรียกดูของในคลังตามแท็ก">
  <PageHeader
    title="แท็กทั้งหมด"
    description="เรียกดูของในคลังตามเครื่องมือหรือเทคนิคที่ปรากฏในเนื้อหา"
    breadcrumbs={[{ label: 'Home', href: '/' }, { label: 'แท็ก' }]}
  />

  {tags.length === 0 ? (
    <p class="empty-state">ยังไม่มีแท็กในคลัง</p>
  ) : (
    <div class="tag-row">
      {tags.map(([tag, list]) => (
        <a class="tag-link" href={`/tags/${tag}/`}>{tag} ({list.length})</a>
      ))}
    </div>
  )}
</BaseLayout>
